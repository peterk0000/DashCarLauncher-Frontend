<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Верхняя часть (занимает всё свободное место) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Нижняя панель (высота 70dp, растянута по ширине) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:background="#001122">

        <!-- Кнопка 1: Пустая/Иконка (как на скрине слева) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <View android:layout_width="match_parent" android:layout_height="3dp" android:background="#D35400"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:drawableTop="@drawable/ic_launcher_foreground"
                android:paddingTop="8dp"/>
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginTop="15dp" android:layout_marginBottom="15dp" android:background="#33FFFFFF" />

        <!-- Кнопка 2: WI-FI -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <View android:layout_width="match_parent" android:layout_height="3dp" android:background="#D35400"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="WI-FI"
                android:textColor="#FFFFFF"
                android:textSize="10sp"/>
            <!--android:drawableTop="@drawable/ic_wifi"-->
            <!-- android:drawablePadding="4dp"
             android:paddingTop="8dp"/> -->
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginTop="15dp" android:layout_marginBottom="15dp" android:background="#33FFFFFF" />

        <!-- Кнопка 3: Bluetooth -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <View android:layout_width="match_parent" android:layout_height="3dp" android:background="#D35400"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Bluetooth"
                android:textColor="#FFFFFF"
                android:textSize="10sp"/>
            <!-- android:drawableTop="@drawable/ic_bluetooth"
             android:drawablePadding="4dp"
             android:paddingTop="8dp"/>-->
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginTop="15dp" android:layout_marginBottom="15dp" android:background="#33FFFFFF" />

        <!-- Кнопка 4: Apps -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <View android:layout_width="match_parent" android:layout_height="3dp" android:background="#D35400"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Apps"
                android:textColor="#FFFFFF"
                android:textSize="10sp"/>
            <!--android:drawableTop="@drawable/ic_apps"
            android:drawablePadding="4dp"
            android:paddingTop="8dp"/>-->
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginTop="15dp" android:layout_marginBottom="15dp" android:background="#33FFFFFF" />

        <!-- Кнопка 5: Voice Assistant -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <View android:layout_width="match_parent" android:layout_height="3dp" android:background="#D35400"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Voice assistant"
                android:textColor="#FFFFFF"
                android:textSize="10sp"/>
            <!-- android:drawableTop="@drawable/ic_mic"
             android:drawablePadding="4dp"
             android:paddingTop="8dp"/> -->
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginTop="15dp" android:layout_marginBottom="15dp" android:background="#33FFFFFF" />

        <!-- Кнопка 6: Settings -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <View android:layout_width="match_parent" android:layout_height="3dp" android:background="#D35400"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Settings"
                android:textColor="#FFFFFF"
                android:textSize="10sp"/>
            <!--android:drawableTop="@drawable/ic_settings"
            android:drawablePadding="4dp"
            android:paddingTop="8dp"/>-->
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
