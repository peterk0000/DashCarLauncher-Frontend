<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="@color/black">

    <fragment
        android:id="@+id/home_screen" android:name="com.example.dashcarlauncher_frontend.HomeScreen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        tools:layout="@layout/fragment_screen"
        tools:ignore="Suspicious0dp" />
    <fragment
        android:id="@+id/buttons" android:name="com.example.dashcarlauncher_frontend.Buttons"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        tools:layout="@layout/fragment_buttons"/>

</LinearLayout>